  "catalog": {
    "key": "forms.bank-entities",
    "originalCulture": "es",
    "name": {
      "es": "Bancos y billeteras",
      "en": "Banks and wallets"
    },
    "description": {
      "es": "Los bancos y las billeteras de las transferencias. El código es el de la entidad en la cuenta: los tres primeros dígitos de una CBU, según la tabla del BCRA.",
      "en": "The banks and wallets of transfers. The code is the entity's in the account: the first three digits of a CBU, as the BCRA table gives them."
    }
  },
  "reading": {
    "recognition": {
      "es": "Comprobante de una transferencia de dinero entre dos cuentas, de cualquier banco o billetera virtual. Suele decir «Transferencia», «Comprobante» u «Operación exitosa» y muestra el monto, la fecha y la hora, el número de operación y las cuentas de origen y de destino (CBU, CVU o alias) con sus titulares y su CUIT o CUIL; a veces, un concepto. No es una factura, un recibo ni un ticket de compra.",
      "en": "Receipt of a money transfer between two accounts, from any bank or digital wallet. It usually says «Transferencia», «Comprobante» or «Operación exitosa» and shows the amount, the date and time, the operation number and the source and destination accounts (CBU, CVU or alias) with their holders and their CUIT or CUIL; sometimes, a concept. It is not an invoice, a payment receipt or a purchase ticket."
    },
    "summary": {
      "es": "Recibí un comprobante de transferencia de {amount} del {sourceBank}. ¿Lo cargo?",
      "en": "I got a transfer receipt for {amount} from {sourceBank}. Shall I load it?"
    },
    "duplicateKeys": [
      "operationNumber",
      "amount",
      "date"
    ],
    "currencies": {
      "amount": "currency"
    }
  }
